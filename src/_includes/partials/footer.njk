<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__col site-footer__brand">
      <p class="site-footer__logo">Igreja Evangélica<br>de Livramento</p>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
      <ul class="site-footer__social">
        <li>
          <a href="{{ site.social.facebook }}" rel="noopener" target="_blank" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.5-3.9 3.77-3.9 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.45 2.9h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z"/></svg>
            <span>Facebook</span>
          </a>
        </li>
        <li>
          <a href="{{ site.social.youtube }}" rel="noopener" target="_blank" aria-label="YouTube">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.53A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.12 2.12c1.88.53 9.38.53 9.38.53s7.5 0 9.38-.53a3 3 0 0 0 2.12-2.12A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.27 3.6L9.6 15.6Z"/></svg>
            <span>YouTube</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="site-footer__col">
      <h2 class="site-footer__heading">Os nossos valores</h2>
      <ul class="site-footer__values">
        {% for v in site.values %}
        <li><strong>{{ v.group }}</strong><span>{{ v.items }}</span></li>
        {% endfor %}
      </ul>
    </div>
    <div class="site-footer__col">
      <h2 class="site-footer__heading">Páginas</h2>
      <ul class="site-footer__links">
        <li><a href="/quem-somos/sobre/">Quem Somos</a></li>
        <li><a href="/quem-somos/no-que-cremos/">No que Cremos</a></li>
        <li><a href="/mensagens/youtube/">Mensagens</a></li>
        <li><a href="/recursos/sugestoes-de-leitura/">Recursos</a></li>
        <li><a href="/onde-estamos/">Onde Estamos</a></li>
      </ul>
    </div>
    <div class="site-footer__col">
      <h2 class="site-footer__heading">Onde estamos</h2>
      <address class="site-footer__address">
        <a href="{{ site.address.mapsUrl }}" rel="noopener" target="_blank">{{ site.address.street }}<br>{{ site.address.postal }}</a>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <a href="tel:+351{{ site.phone }}">{{ site.phoneDisplay }}</a>
      </address>
      <p class="site-footer__schedule">Celebração: domingos às 10:30</p>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <p>© {{ "" | year }} {{ site.name }}</p>
  </div>
</footer>
