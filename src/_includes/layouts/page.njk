---
layout: layouts/base.njk
---
<header class="page-header">
  <div class="container">
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </div>
</header>
<article class="page-body container prose">
  {{ content | safe }}
</article>
